<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Exposes only filesDir/logs/ — not the whole filesDir, which may hold other private data. -->
    <files-path name="logs" path="logs/" />
    <!-- "Submit Logs" (InfoActivity) writes its anonymized copy into cacheDir before sharing. -->
    <cache-path name="shared_logs" path="." />
</paths>
